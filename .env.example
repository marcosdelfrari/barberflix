# Configuração do Banco de Dados PostgreSQL
# Copie este arquivo para .env e altere os valores conforme sua configuração

# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barberflix"

# Produção (Oracle Cloud PostgreSQL) – banco cavalheiros. Endpoint é IP privado (10.0.1.59):
# use Bastion (túnel) e conecte em 127.0.0.1. Ver docs/OCI-POSTGRES-ACESSO.md.
# DATABASE_URL="postgresql://admin:Admin%40123@127.0.0.1:5432/cavalheiros?sslmode=require"

# Aplicar schema (migrations) e seed no banco de produção:
# 1. Defina DATABASE_URL no .env com a URL de produção (ou exporte no terminal).
# 2. Schema (tabelas): npm run db:prod:deploy
# 3. Seed (dados iniciais): npm run db:prod:seed
# Ou tudo de uma vez: npm run db:prod:setup
#
# Se der P1001 "Can't reach database server": OCI PostgreSQL não tem tela "Allowed IPs".
# Veja docs/OCI-POSTGRES-ACESSO.md para onde configurar rede (Security List / NSG ou Bastion).

# Para usar com Docker, execute:
# docker run --name barberflix-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=barberflix -p 5432:5432 -d postgres:16

# NextAuth / Auth.js – OBRIGATÓRIO em produção (Vercel, etc.)
# Sem AUTH_SECRET você verá: [auth][error] MissingSecret
# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URL da aplicação (ajuste para produção)
NEXTAUTH_URL="http://localhost:3000"
