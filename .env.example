# Configuração do Banco de Dados PostgreSQL
# Copie este arquivo para .env e altere os valores conforme sua configuração

# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barberflix"

# Para usar com Docker, execute:
# docker run --name barberflix-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=barberflix -p 5432:5432 -d postgres:16

# NextAuth Configuration
# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URL da aplicação (ajuste para produção)
NEXTAUTH_URL="http://localhost:3000"
